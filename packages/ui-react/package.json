{
	"name": "@andromeda/ui-react",
	"version": "1.0.0",
	"description": "React component library for the Andromeda design system",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/your-org/andromeda"
	},
	"type": "module",
	"files": [
		"src",
		"dist"
	],
	"main": "./dist/ui-react.umd.js",
	"module": "./dist/ui-react.es.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/ui-react.es.js",
			"require": "./dist/ui-react.umd.js"
		}
	},
	"peerDependencies": {
		"react": "18.0.0 || 19.0.0",
		"react-dom": "18.0.0 || 19.0.0"
	},
	"scripts": {
		"build": "vite build && tsc --emitDeclarationOnly"
	},
	"dependencies": {
		"@floating-ui/react": "0.27.19"
	},
	"devDependencies": {
		"@types/node": "25.6.2",
		"@vitejs/plugin-react": "6.0.1",
		"vite": "8.0.12"
	}
}
