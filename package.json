{
	"name": "andromeda",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@chromatic-com/storybook": "5.1.2",
		"@storybook/addon-a11y": "10.3.6",
		"@storybook/addon-docs": "10.3.6",
		"@storybook/addon-onboarding": "10.3.6",
		"@storybook/addon-vitest": "10.3.6",
		"@storybook/react-vite": "10.3.6",
		"@types/bun": "latest",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"@vitest/browser-playwright": "4.1.5",
		"@vitest/coverage-v8": "4.1.5",
		"docs": "workspace:*",
		"kill-port": "2.0.1",
		"playwright": "1.59.1",
		"storybook": "10.3.6",
		"typescript": "6.0.3",
		"vite": "8.0.10",
		"vitest": "4.1.5"
	},
	"scripts": {
		"dev:sandbox": "bun --filter sandbox dev",
		"dev:docs": "bun --filter docs storybook",
		"build:lib": "bun --filter @andromeda/ui-react build",
		"format": "biome format --write .",
		"lint": "biome check .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"dependencies": {
		"@andromeda/css-framework": "workspace:*",
		"@andromeda/ui-react": "workspace:*",
		"@radix-ui/react-dialog": "1.1.15",
		"lucide-react": "1.14.0",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"ui-react": "^1.0.3"
	}
}
